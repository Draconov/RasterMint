{
  "id": "dos-vga",
  "name": "DOS VGA 320×200",
  "category": "Computer",
  "summary": "Creative VGA Mode 13h-style 320×200 output with 256-colour indexing and CRT display treatment.",
  "raster": {
    "width": 320,
    "height": 200,
    "pixel_aspect": [
      5,
      6
    ],
    "tile": [
      0,
      0
    ],
    "fit_mode": "fit"
  },
  "palette": {
    "type": "native-depth",
    "name": "VGA 6-bit DAC",
    "description": "Creative approximation of VGA 6-bit-per-channel DAC output with up to 256 indexed colours on-screen."
  },
  "recommended_dither": "Nearest Palette",
  "visual": {
    "display": {
      "kind": "crt",
      "gamma": 1.0,
      "blur": 0.25,
      "color_bleed": 0.25,
      "scanlines": 0.08,
      "lcd_grid": 0.0
    },
    "effects": [
      {
        "kind": "CRT Mask",
        "params": {
          "mask_type": "Aperture Grille",
          "scale": 3,
          "strength": 0.14,
          "brightness": 0.05
        }
      },
      {
        "kind": "Phosphor Glow",
        "params": {
          "threshold": 0.68,
          "radius": 1.1,
          "intensity": 0.13
        }
      },
      {
        "kind": "Display Persistence",
        "params": {
          "display_type": "CRT",
          "persistence_time": 0.055,
          "strength": 0.12,
          "decay": 1.7
        }
      }
    ]
  },
  "strict": {
    "supported": true,
    "constraints": {
      "channel_bits": [
        6,
        6,
        6
      ],
      "max_colors_global": 256
    }
  },
  "sources": []
}
