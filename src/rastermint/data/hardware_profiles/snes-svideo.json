{
  "id": "snes-svideo",
  "name": "SNES S-Video",
  "category": "Console",
  "summary": "Cleaner SNES/Super Famicom presentation with reduced composite bleed and a crisp CRT treatment.",
  "raster": {
    "width": 256,
    "height": 224,
    "pixel_aspect": [
      8,
      7
    ],
    "tile": [
      8,
      8
    ],
    "fit_mode": "fit"
  },
  "palette": {
    "type": "native-depth",
    "name": "SNES RGB555",
    "description": "15-bit master colour space; games select smaller palettes per scene."
  },
  "recommended_dither": "Nearest Palette",
  "visual": {
    "display": {
      "kind": "crt",
      "gamma": 1.02,
      "blur": 0.18,
      "color_bleed": 0.15,
      "scanlines": 0.1,
      "lcd_grid": 0.0
    },
    "effects": [
      {
        "kind": "CRT Mask",
        "params": {
          "mask_type": "Aperture Grille",
          "scale": 3,
          "strength": 0.14,
          "brightness": 0.05
        }
      },
      {
        "kind": "Phosphor Glow",
        "params": {
          "threshold": 0.7,
          "radius": 1.0,
          "intensity": 0.1
        }
      },
      {
        "kind": "Display Persistence",
        "params": {
          "display_type": "CRT",
          "persistence_time": 0.06,
          "strength": 0.13,
          "decay": 1.7
        }
      }
    ]
  },
  "strict": {
    "supported": true,
    "constraints": {
      "channel_bits": [
        5,
        5,
        5
      ],
      "max_colors_global": 256
    }
  },
  "sources": []
}
